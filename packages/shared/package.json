{
  "name": "@smoke/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, cell math, and the single source of truth for MECHANICS.md numbers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:land-mask": "tsx scripts/generate-land-mask.ts",
    "generate:tower-names": "tsx scripts/generate-tower-names.ts"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "all-the-cities": "^3.1.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "world-atlas": "^2.0.2"
  }
}
