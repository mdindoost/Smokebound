# Copy to .env and fill in. Never commit the real file.

# Postgres connection string for your Supabase project.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# (Use the session/direct connection, not the pooler, when running migrations.)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Client-side Supabase credentials (used from M4 onwards).
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Engine-side service credentials (used from M2/M3 onwards).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
