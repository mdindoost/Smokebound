# Copy to .env and fill in. Never commit the real file.
#
# This file is for the *engine and the migrations* (Node, run from the repo
# root). The mobile app reads its own file — see apps/mobile/.env.example —
# because Expo loads .env from the app directory, not the workspace root.

# --- required ---------------------------------------------------------------

# Postgres connection string for your Supabase project.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# (Use the direct connection, not the pooler, when running migrations.)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Signs preview tokens (ARCHITECTURE §6.4). Any long random string; keep it
# stable, or previews issued before a restart stop matching their sends.
#   openssl rand -base64 32
PREVIEW_TOKEN_SECRET="change-me"

# --- optional ---------------------------------------------------------------

# table (default) = fully outbound, the launch configuration; http | both | none
ENGINE_TRANSPORT="table"

# NWS asks every client to identify itself with a contact address.
NWS_USER_AGENT="(smoke, you@example.com)"

# Only needed when ENGINE_TRANSPORT includes http.
# Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=""

# Not used yet; M6 push dispatch will want it.
SUPABASE_SERVICE_ROLE_KEY=""
