# Copy to apps/mobile/.env and fill in. Never commit the real file.
#
# Expo loads .env from the *app* directory, so these live here rather than in
# the workspace root. Everything prefixed EXPO_PUBLIC_ is compiled into the
# bundle and is readable by anyone with the app — the anon key is designed for
# that; nothing secret belongs in this file.

# Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# table (default) = the client reaches the engine through the database, so the
# engine can live behind NAT. Set to http only if you expose the engine.
EXPO_PUBLIC_ENGINE_TRANSPORT="table"
# EXPO_PUBLIC_ENGINE_URL="http://192.168.1.10:8787"
