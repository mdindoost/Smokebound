{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "test/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
