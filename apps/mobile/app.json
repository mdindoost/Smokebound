{
  "expo": {
    "name": "SMOKE",
    "slug": "smoke",
    "scheme": "smoke",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
